# Seoul Open Data - GetParkingInfo
SEOUL_OPEN_API_KEY=

# Gyeonggi Traffic Information Center parking info and availability (server only)
GYEONGGI_GITS_API_KEY=

# Dormant Kakao integrations (not used by the current runtime)
KAKAO_REST_API_KEY=
KAKAO_MOBILITY_REST_API_KEY=

# Kakao web map and Kakao Navi JavaScript SDK
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# Naver Web Dynamic Map. Current JavaScript API uses ncpKeyId.
NEXT_PUBLIC_NAVER_MAP_NCP_KEY_ID=

# Naver NCP Geocoding and Directions 5 server-only credentials.
NAVER_MAP_NCP_KEY_ID=
NAVER_MAP_NCP_CLIENT_SECRET=

# Naver API HUB Local Search server-only credentials.
NAVER_API_HUB_KEY_ID=
NAVER_API_HUB_KEY=

# Optional Vercel Web Analytics API credentials for TODAY / 30 DAYS footer counts.
VERCEL_ANALYTICS_TOKEN=
VERCEL_ANALYTICS_TEAM_ID=

# Naver app URL Scheme requires appname. For mobile web, use the deployed web URL.
NEXT_PUBLIC_NAVER_APP_NAME=http://localhost:3000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GITHUB_REPO_URL=
