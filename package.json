{
  "name": "parkpick-seoul",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "GPS-first Seoul public parking recommendation PWA with Naver Maps routing and navigation.",
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --experimental-https --turbopack",
    "check:repo": "node scripts/check-repo.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "next build",
    "verify": "npm run check:repo && npm run lint && npm run typecheck && npm test && npm run build",
    "start": "next start"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "lucide-react": "1.33.0",
    "next": "16.3.2",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhm8029/parkpick-seoul.git"
  },
  "homepage": "https://github.com/yhm8029/parkpick-seoul#readme"
}
